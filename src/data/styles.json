ock;\n  }\n  .header__menu {\n    max-width: 500px;\n  }\n}\n\n\n/* 全体フォント */\n.page {\n  font-family: \"Noto Sans JP\", \"Helvetica Neue\", Arial,\n    \"Hiragino Kaku Gothic ProN\", \"Hiragino Sans\", Meiryo, sans-serif;\n}\n\n.notion-text {\n  line-height: var(--main-line-height);\n  color: #333;\n}\n\n.notion-h2,\n.notion-h3 {\n  color: #333;\n}\n\n/* 目次 */\n.notion-table-of-contents {\n  padding: 16px;\n  background-color: #f5f8fa;\n  border-radius: 4px;\n}\n\n.notion-table-of-contents::before {\n  content: \"▼ 目次\";\n}\n\n/* メタ情報を2カラム化 */\n.page[class*=\"pageMap_posts_\"] .notion-collection-row-body {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n}\n\n.page[class*=\"pageMap_posts_\"] .notion-collection-column-title {\n  width: auto;\n  font-size: 10px;\n}\n\n.notion-collection-row-property .notion-collection-column-title {\n  display: flex;\n  align-items: center;\n  width: 160px;\n  padding: 0 6px;\n  color: var(--fg-color-3);\n}\n\n/* レスポンシブ対応 */\n@media (max-width: 640px) {\n  .page[class*=\"pageMap_posts_\"] .notion-collection-row-value,\n  .page[class*=\"pageMap_posts_\"] .notion-collection-row-title {\n    font-size: 10px;\n  }\n\n  .page[class*=\"pageMap_posts_\"] .title {\n    margin-bottom: 15px;\n    font-size: 1.25rem;\n  }\n\n  .page[class*=\"pageMap_posts_\"] .notion-collection-row-body {\n    display: flex;\n    flex-direction: column;\n  }\n\n  .page[class*=\"pageMap_posts_\"] .container h2 {\n    font-size: 1.25rem;\n    line-height: 1.875rem;\n  }\n\n  .page[class*=\"pageMap_posts_\"] .notion-text {\n    font-size: var(--main-font-size);\n    line-height: var(--main-line-height);\n  }\n}\n\n/* ブログ本文 */\n.page[class*=\"pageMap_posts_\"] .container h2 {\n  line-height: 2.25rem;\n  margin: 54px 0 18px;\n  border-bottom: 1px solid;\n  letter-spacing: 0.04rem;\n}\n\n.page[class*=\"pageMap_posts_\"] .container h3 {\n  line-height: 2.25rem;\n  margin: 36px 0 18px;\n  letter-spacing: 0.04rem;\n}\n\n/* ブログ画像 */\n.page[class*=\"pageMap_posts_\"]