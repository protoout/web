"@media(min-width:768px){\n      /* ヘッダーCTAボタン */\n      #header-link-8 {\n        background: #fff;\n        border-radius: 50px;\n        display: flex;\n        justify-content: space-around;\n        align-items: center;\n        max-width: 260px;\n        padding: 5px 15px;\n        color: #06C755;\n        transition: 0.3s ease-in-out;\n        border: solid 2px #06C755;\n        margin-left: 15px;\n      }\n      #header-link-8:hover {\n        background: #06C755;\n        color: #FFF;\n      }\n      #header-link-9 {\n        background: #fff;\n        border-radius: 50px;\n        display: flex;\n        justify-content: space-around;\n        align-items: center;\n        max-width: 260px;\n        padding: 5px 15px;\n        color: #c40010;\n        transition: 0.3s ease-in-out;\n        border: solid 2px #c40010;\n        margin-left: 15px;\n      }\n      #header-link-9:hover {\n        background: #c40010;\n        color: #FFF;\n      }\n    }\n    /* 固定表示のCTAバー */\n    .article-cta-bar {\n      position: fixed;\n      bottom: 0;\n      left: 0;\n      right: 0;\n      display: flex;\n      justify-content: center;\n      gap: 0.5rem;\n      background-color: #f5f5f5;\n      padding: 16px 1rem;\n      z-index: 1000;\n    }\n    /* ボタン共通 */\n    .article-cta {\n      flex: 1;\n      max-width: 300px;\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      padding: 0.75rem 1.5rem;\n      border-radius: 6px;\n      font-weight: bold;\n      text-decoration: none;\n      font-size: 1rem;\n      white-space: nowrap;\n      transition: background-color 0.3s, color 0.3s;\n    }\n    .article-cta--white {\n      background-color: #fff;\n      color: #003366;\n      border: 2px solid #003366;\n    }\n    .article-cta--white:hover {\n      background-color: #003366;\n      color: #fff;\n    }\n    .article-cta--red {\n      background-color: #c40010;\n      color: #fff;\n      border: 2px solid #c40010;\n    }\n    .article-cta--red:hover {\n      background-color: #9a000c;\n    }\n    .article-cta-arrow {\n      display: inline-block;\n      margin-left: 0.5em;\n      font-size: 1.2em;\n      line-height: 1;\n    }\n    /* フル／ショートテキストの切り替え */\n    .cta-label--short { display: none; }\n    @media (max-width: 767px) {\n      /* 縦並び */\n      .article-cta-bar {\n        flex-direction: column;\n        gap: 1rem;\n      }\n      .article-cta {\n        max-width: 100%;\n      }\n      .cta-label--full { display: none; }\n      .cta-label--short { display: inline; }\n    }\n    /* 本文が隠れないよう余白確保 */\n    .page, body {\n      padding-bottom: calc(50px + 16px);\n    }\n  "